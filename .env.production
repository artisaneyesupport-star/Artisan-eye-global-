# =====================================================================
#  ArtisanEye — PRODUCTION Environment Variables
#  Copy this to .env on your server and fill in every value.
#  NEVER commit this file to git.
# =====================================================================

# ─── Server ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Your live frontend URL (no trailing slash)
FRONTEND_URL=https://artisaneye.com

# Your live backend URL (used in emails and OAuth callbacks)
APP_URL=https://artisaneye.com

# ─── Database ─────────────────────────────────────────────────────────
# Railway: copy from your Railway PostgreSQL service "Connect" tab
# Render:  copy from your Render PostgreSQL "Connection String"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/artisaneye

# ─── JWT ──────────────────────────────────────────────────────────────
# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────────────────
# https://console.cloudinary.com/ → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Paystack ─────────────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
# Use LIVE keys (sk_live_...) in production
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Plan codes — create in Paystack dashboard → Products → Plans
PAYSTACK_PLAN_PRO=PLN_xxxxxxxxxxxxxxx
PAYSTACK_PLAN_TEAM=PLN_xxxxxxxxxxxxxxx
PAYMENT_CALLBACK_URL=https://artisaneye.com/billing-success.html

# ─── Email (SMTP) ─────────────────────────────────────────────────────
# Recommended providers: Zoho Mail (free), SendGrid, Brevo, Mailgun
#
# Zoho Mail example:
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@artisaneye.com
# SMTP_PASS=your_zoho_app_password
#
# SendGrid example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key

SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@artisaneye.com
SMTP_PASS=your_app_password
EMAIL_FROM=ArtisanEye <noreply@artisaneye.com>
SUPPORT_EMAIL=support@artisaneye.com

# ─── Sentry (error monitoring) ────────────────────────────────────────
# https://sentry.io → New Project → Node.js → copy DSN
# Leave blank to disable error monitoring
SENTRY_DSN=

# ─── Backups ──────────────────────────────────────────────────────────
# VPS only: set this to write backups to local disk
# On Railway/Render: leave blank — backups go to Cloudinary automatically
# BACKUP_DIR=/var/backups/artisaneye
BACKUP_KEEP_DAYS=7
