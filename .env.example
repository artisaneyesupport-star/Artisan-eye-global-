# ─── Database ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/artisaneye"

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_64_char_random_hex"
JWT_REFRESH_SECRET="replace_with_another_64_char_random_hex"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────
# The URL your frontend is served from (for local dev this is usually file:// or a local server)
FRONTEND_URL="http://localhost:4000"

# ─── Paystack ─────────────────────────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your_webhook_secret"

# Plan codes — create these in Paystack dashboard under Products > Plans
PAYSTACK_PLAN_PRO="PLN_xxxxxxxxxxxxxxx"
PAYSTACK_PLAN_TEAM="PLN_xxxxxxxxxxxxxxx"

# Redirect URL after successful payment
PAYMENT_CALLBACK_URL="http://localhost:4000/billing-success.html"

# ─── Email (Nodemailer) ───────────────────────────────────────────────
# For development: use Ethereal (fake SMTP) — auto-configured if left blank
# For production: use your real SMTP provider (Gmail, Zoho, SendGrid, etc.)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_ethereal_user@ethereal.email"
SMTP_PASS="your_ethereal_password"

# From address shown in all outgoing emails
EMAIL_FROM="ArtisanEye <noreply@artisaneye.com>"

# Base URL used to build links in emails
APP_URL="http://localhost:4000"

# ─── Cloudinary (photo uploads) ───────────────────────────────────────
# Get from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Support inbox ─────────────────────────────────────────────────────
# Where contact form emails are delivered
SUPPORT_EMAIL="support@artisaneye.com"

# ─── Admin ────────────────────────────────────────────────────────────
# To create an admin user, register normally then run:
# UPDATE users SET role = 'ADMIN' WHERE email = 'admin@artisaneye.com';
